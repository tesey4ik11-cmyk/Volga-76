terials:"Профильная труба 120×80/100×50, сэндвич PIR 120 мм, Grand Line",duration:"38 рабочих дней",year:2026,status:"ЗАВЕРШЁН",mainImage:"/img/sandwich-panels.jpg",gallery:["/img/sandwich-panels.jpg","/img/case-piles.jpg"],specs:[{label:"Несущий каркас",value:"Сталь 09Г2С с двухслойной антикоррозией"},{label:"Теплоизоляция",value:"PIR-панели, коэффициент сопротивления 4.6 м²·°С/Вт"},{label:"Кровля",value:"Двускатная 14°, водосточная система D150"},{label:"Ворота",value:"Секционные промышленные 3.5 × 3.5 м с электроприводом"}],description:"Инженерный расчет металлоемкости позволил снизить вес каркаса на 18% без потери несущей способности под снеговые мешки Ярославской зимы."},{id:"vgs-031",code:"VGS-031",title:"Деревянный каркасный дом для круглогодичного проживания",region:"Ярославская область",district:"Ярославль, Заволжский район",type:"Каркасный дом под чистовую отделку",area:"135 м² (9 × 9 м с террасой 24 м²)",foundation:"Свайное поле 24 сваи Ø89×2500 с оголовками 200×200",materials:"Сухой строганный брус 150×50 камерной сушки, Rockwool 200 мм",duration:"45 рабочих дней",year:2026,status:"В РАБОТЕ",mainImage:"/img/frame-house.jpg",gallery:["/img/frame-house.jpg","/img/case-terrace.jpg","/img/deck-dpk.jpg"],specs:[{label:"Влажность древесины",value:"12-14% (камерная сушка, антисептик Неомид 430)"},{label:"Утепление пола и кровли",value:"250 мм перекрестное"},{label:"Утепление стен",value:"200 мм с ветрозащитной плитой Белтермо 25 мм"},{label:"Оконные блоки",value:"Rehau Grazio 70 мм, 2-камерный энергосберегающий стеклопакет"}],description:"Строительство дома по энергоэффективному скандинавскому стандарту. Теплый контур сдан точно в срок, ведутся внутренние инженерные сети."},{id:"vgs-014",code:"VGS-014",title:"Наружные инженерные сети и водоотведение поселка",region:"Ярославская область",district:"Рыбинский район, берег Волги",type:"Канализация К1 + водопровод В1",area:"Трасса 140 м.п., 4 смотровых колодца, насосная станция",foundation:"Песчано-гравийная подушка 200 мм с уплотнением",materials:"Трубы SN4 Ø110/160 рыжие, ПНД питьевая Ø32 SDR11",duration:"14 рабочих дней",year:2025,status:"ЗАВЕРШЁН",mainImage:"/img/trench-nets.jpg",gallery:["/img/trench-nets.jpg","/img/piles-screw.jpg"],specs:[{label:"Глубина заложения",value:"1.75 м (норматив ЯО 1.50 м + запас)"},{label:"Уклон самотечной сети",value:"2.0 см на 1 погонный метр (лазерный контроль)"},{label:"Опрессовка",value:"Водопровод испытан давлением 6.0 атм"},{label:"Документация",value:"Исполнительная съемка с GPS-привязкой поворотов"}],description:"Трассировка и укладка наружных сетей в сложных грунтах с высоким УГВ. Ни единого промерзания за две зимы."}],fg=[{id:"yaroslavl",name:"Ярославль",x:58,y:48,projectsCount:7,recentProjects:["Каркасный дом 135 м² (Заволжье)","Терраса ДПК 85 м² (Брагино)","Свайный фундамент под цех"],featuredProjectCode:"VGS-031"},{id:"rybinsk",name:"Рыбинск",x:34,y:22,projectsCount:4,recentProjects:["Инженерные сети 140 м","Терраса вокруг чаши","Свайное поле под дом"],featuredProjectCode:"VGS-014"},{id:"tutaev",name:"Тутаев",x:44,y:38,projectsCount:3,recentProjects:["Банно-водный комплекс с террасой","Наружные сети коттеджа","Свайный фундамент"],featuredProjectCode:"VGS-026"},{id:"rostov",name:"Ростов Великий",x:52,y:72,projectsCount:2,recentProjects:["Склад из сэндвич-панелей 180 м²","Пристройка на винтовых сваях"],featuredProjectCode:"VGS-019"},{id:"pereslavl",name:"Переславль-Залесский",x:46,y:88,projectsCount:1,recentProjects:["Свайный фундамент на сложном рельефе"]},{id:"uglich",name:"Углич",x:24,y:42,projectsCount:1,recentProjects:["Каркасный дом 90 м² и открытая терраса"]},{id:"gavrilov-yam",name:"Гаврилов-Ям",x:62,y:64,projectsCount:1,recentProjects:["Инженерные коммуникации и теплый контур"]}],OB=[{name:"Павел",place:"Ростов Великий",service:"Металлокаркас / Склад",rating:5,text:"Металлокаркас склада 12×6 с сэндвич-панелями. Расчёт по снеговой нагрузке показали до начала работ, всё по СП 20. Собрали за месяц, ни единого вопроса по качеству швов.",created_at:"2026-09-12"},{name:"Дмитрий",place:"Тутаев",service:"Терраса ДПК / Сваи",rating:5,text:"Терраса ДПК 120 м² на винтовых сваях. Зазоры ровные строго 4 мм, ступени удобные, под доской геотекстиль и щебень. Проверили лазером — горизонт идеальный, ничего не просело.",created_at:"2026-09-05"},{name:"Алексей",place:"Переславль-Залесский",service:"Свайный фундамент под баню",rating:4,text:"Фундамент на 14 свай сделали за один световой день, геометрия и горизонт в ноль. Снял балл за задержку манипулятора с обвязкой на 3 часа из-за пробки на въезде в город, но предупредили заранее.",created_at:"2026-09-08"},{name:"Андрей",place:"Ярославль",service:"Свайный фундамент",rating:5,text:"Заказывал свайное поле под пристройку — 18 свай Ø89. Приехали со своей техникой, за день всё завинтили, срезали в один горизонт, залили бетоном. Никаких доплат сверх сметы не было.",created_at:"2026-09-04"},{name:"Игорь",place:"Ярославский район",service:"Бассейн и терраса",rating:5,text:"Бассейн с полной обвязкой и терраса 80 квадратов. Оборудование, ёмкости, павильон — всё запустили и объяснили, как обслуживать. Смета была расписана построчно до копейки.",created_at:"2026-08-23"},{name:"Виктор Николаевич",place:"Углич",service:"Наружные сети и септик",rating:4,text:"Трубы проложили на 1.8 м по нивелиру, исполнительную схему сдали. По качеству работ отлично. Четвёрка за то, что грунт после обратной засыпки траншеи утрамбовывали дольше обещанного.",created_at:"2026-08-19"},{name:"Елена",place:"Некрасовское",service:"Каркасный дом",rating:5,text:"Дом 6×8: сваи, коробка за три недели, крыша из металлочерепицы. Каждый этап сдавался с подробным отчётом и актами. Перезимовали — тепло, нигде не дует, ничего не повело.",created_at:"2026-08-15"},{name:"Михаил",place:"Рыбинский район",service:"Свайное поле и забор",rating:3,text:"Сваи и каркас забора поставили крепко, вопросов к нормам нет. Оценку снизил из-за того, что в первый день сломался гидробур на экскаваторе и монтаж сдвинулся на полтора дня. Но по смете не накрутили ни рубля.",created_at:"2026-08-11"},{name:"Сергей",place:"Ярославль",service:"Наружные сети",rating:5,text:"Провели канализацию 60 метров и воду к дому. Работали с лазерным нивелиром, всё строго по уклону 2 см/м. Сдали исполнительную схему — теперь точно знаю, где проходит трасса.",created_at:"2026-08-05"},{name:"Марина",place:"Гаврилов-Ям",service:"Инженерная отделка",rating:5,text:"Отделка техздания под ключ: электрика по ГОСТу, тёплый пол, сантехника. Работали аккуратно, мусор вывозили сами. Смета не выросла ни на рубль.",created_at:"2026-09-10"},{name:"Анна",place:"Рыбинск",service:"Терраса и забор",rating:5,text:"Сваи под веранду и забор 40 метров из профлиста. Был сильный дождь, но предупредили заранее и график нагнали. По расходам — ровно как в предварительной смете.",created_at:"2026-08-30"}],FB=[{step:"01",title:"УЧАСТОК И ОСИ",subtitle:"Лазерная геодезия и привязка",details:"Оптическое нивелирование перепада высот участка, вынос строительных осей в натуру, проверка несущих свойств грунта и уровня грунтовых вод.",badge:"Точность ±3 мм"},{step:"02",title:"ФУНДАМЕНТ",subtitle:"Винтовые сваи ниже промерзания",details:"Завинчивание механизированным гидровращателем на глубину 2.5–3.0 м (глубже нормативного промерзания ЯО 1.45 м). Бетонирование стволов М300, швеллерный ростверк.",badge:"Несущая способность до 4.5 т/свая"},{step:"03",title:"КАРКАС",subtitle:"Сварной металл или сухой брус",details:"Сборка силового скелета здания или настила. Профильная труба 100×50/80×80 с антикоррозийной защитой или калиброванный брус камерной сушки 12% влажности.",badge:"Расчет СП 20: Снег 2.0 кПа"},{step:"04",title:"ИНЖЕНЕРИЯ",subtitle:"Сети, закладные и обвязка",details:"Укладка трасс канализации с уклоном 2 см/м, подвод воды ниже 1.6 м в термоизоляции, гидравлическая опрессовка узлов, фильтрация бассейна Aquaviva.",badge:"Опрессовка 1.5–6.0 атм"},{step:"05",title:"ОТДЕЛКА",subtitle:"Сэндвич-панели и настил ДПК",details:"Теплый контур с герметизацией замков Z-lock, монтаж полнотелой доски ДПК 160×25 со скрытыми кляймерами из нержавеющей стали, геотекстиль и щебень.",badge:"Зазоры 4 мм, гарантия геометрии"},{step:"06",title:"СДАЧА ОБЪЕКТА",subtitle:"Исполнительная документация",details:"Передача заказчику полного пакета: исполнительные чертежи трасс, паспорта оборудования, акт выполненных работ и официальный гарантийный сертификат.",badge:"Фиксация сметы 100%"}],IB=()=>{const[n,e]=pt.useState(0);return b.jsx("section",{id:"sequence",className:"py-20 bg-[#060a12] border-b border-slate-850 relative",children:b.jsxs("div",{className:"max-w-7xl mx-auto px-4",children:[b.jsxs("div",{className:"max-w-3xl mb-12 space-y-3",children:[b.jsxs("div",{className:"inline-flex items-center gap-2 px-2.5 py-1 bg-blue-950/70 border border-blue-800/60 rounded text-xs font-mono text-blue-400 font-semibold uppercase",children:[b.jsx(Nm,{className:"w-3.5 h-3.5"}),"Инженерная методология ВОЛГАСТРОЙ 76"]}),b.jsxs("h2",{className:"text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight",children:["ОДИН УЧАСТОК. ",b.jsx("span",{className:"text-blue-500",children:"ОДИН ПОДРЯДЧИК."}),b.jsx("br",{}),"ВЕСЬ ОБЪЕКТ."]}),b.jsx("p",{className:"text-slate-300 text-base leading-relaxed",children:"Вам не нужно искать 5 разных бригад: одних на сваи, вторых на каркас, третьих на трубы, а четвертых на террасу. Мы ведём весь строительный цикл как непрерывную инженерную систему, где каждый последующий этап строго стыкуется с предыдущим по осям и проектным высотам."})]}),b.jsx("div",{className:"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4",children:FB.map((t,i)=>{const r=n===i;return b.jsxs("div",{onClick:()=>e(i),className:`relative p-6 rounded-xl border transition-all cursor-pointer ${r?"bg-slate-900 border-blue-500 shadow-xl shadow-blue-950/40":"bg-[#0a0f1c] border-slate-800/80 hover:border-slate-700"}`,children:[b.jsxs("div",{className:"flex items-center justify-between mb-4",children:[b.jsx("span",{className:"font-mono text-2xl font-black text-blue-400",children:t.step}),b.jsx("span",{className:"px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800/80 text-slate-300 border border-slate-700/60",children:t.badge})]}),b.jsx("h3",{className:"text-lg font-bold text-white mb-1 tracking-tight",children:t.title}),b.jsx("div",{className:"text-xs font-mono text-blue-400 mb-3 font-medium",children:t.subtitle}),b.jsx("p",{className:"text-slate-300 text-sm leading-relaxed",children:t.details}),r&&b.jsx("div",{className:"absolute bottom-0 left-4 right-4 h-1 bg-blue-500 rounded-t-sm"})]},t.step)})}),b.jsxs("div",{className:"mt-12 p-6 rounded-xl bg-slate-900/90 border border-blue-500/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-6",children:[b.jsxs("div",{className:"space-y-1",children:[b.jsxs("div",{className:"text-sm font-bold text-white flex items-center gap-2",children:[b.jsx(Lh,{className:"w-5 h-5 text-blue-400"}),b.jsx("span",{children:"Единая юридическая и гарантийная ответственность"})]}),b.jsx("p",{className:"text-xs text-slate-300 max-w-2xl",children:"Если каркас ставят те же инженеры, кто завинчивал сваи и заливал ростверк, исключены споры о «чужих кривых осях». Мы гарантируем геометрическую точность и передаем объект с исполнительными схемами."})]}),b.jsxs("a",{href:"#configurator",className:"flex items-center gap-2 px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold font-mono uppercase tracking-wider shrink-0 transition-colors",children:[b.jsx("span",{children:"Собрать свой комплекс"}),b.jsx(rm,{className:"w-4 h-4"})]})]})]})})},vn={"pile-install-76":{id:"pile-install-76",name:"Механизированное завинчивание винтовой сваи Ø76 мм",unit:"шт",marketPrice:1300,price:1170,category:"pile",type:"work",region:"Ярославская область",source:"Региональный прайс свайного бурения «Сваи-76» Ярославль,",date:"2026-02",notes:"Завинчивание малогабаритной гидробуровой установкой на глубину 2.0-2.5 м ниже точки промерзания"